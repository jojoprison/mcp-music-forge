# syntax=docker/dockerfile:1
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=Asia/Bangkok

# Install system deps with cache
RUN --mount=type=cache,target=/var/cache/apt \
    --mount=type=cache,target=/var/lib/apt/lists \
    apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg curl ca-certificates tzdata unzip \
    && curl -fsSL https://deno.land/install.sh | DENO_INSTALL=/usr/local sh

# Install uv (fast Python package manager)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && ln -sf /root/.local/bin/uv /usr/local/bin/uv

WORKDIR /app

# Copy project metadata first for better layer caching
COPY pyproject.toml README.md ./

# Install deps system-wide with cache
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system .

# Copy sources
COPY . .

EXPOSE 8033

# Хост берём из окружения. Дефолт 0.0.0.0 нужен для bridge-сети (dev):
# там 127.0.0.1 внутри контейнера недостижим снаружи даже через ports.
# На проде (network_mode: host) выставляется API_HOST=127.0.0.1 — там
# loopback общий с хостом, и это закрывает порт от интернета.
# exec обязателен: без него uvicorn не PID 1 и не получает SIGTERM.
CMD ["sh", "-c", "exec uvicorn api.main:app --host ${API_HOST:-0.0.0.0} --port ${API_PORT:-8033}"]
